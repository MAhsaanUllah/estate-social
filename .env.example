# EstateSocial Pakistan — Root Environment Reference

### Backend (server/.env.example)
# PORT=5000
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/estate-marketplace?retryWrites=true&w=majority
# JWT_SECRET=replace_with_a_secure_random_32_character_secret_key
# CORS_ORIGIN=https://<your-frontend-app>.vercel.app
# RATE_LIMIT_MAX_REQUESTS=300
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# ALLOW_MEMORY_DB=false

### Frontend (client/.env.example)
# VITE_API_URL=https://<your-backend-app>.onrender.com/api
