# EstateSocial Pakistan — Server Environment Variables Template
PORT=5000
NODE_ENV=production

# Production MongoDB Connection URI (Required in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/estate-marketplace?retryWrites=true&w=majority

# Strong Random JWT Secret (Minimum 16 characters, Required in production)
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key

# Comma-separated list of allowed frontend origins (Set to your Vercel or custom frontend deployment URL)
CORS_ORIGIN=https://<your-frontend-app>.vercel.app

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=300

# Cloudinary Storage for Listing Images (Optional - falls back to local uploads/listings if unconfigured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development / Testing Flags ONLY (Must be omitted or false in production)
ALLOW_MEMORY_DB=false
